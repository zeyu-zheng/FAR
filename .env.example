# Copy to ~/.env and fill in what your run uses. FAR loads it on start and, in
# Docker mode, passes its variables into each agent's container.

# Find stages (label, extract, check): an OpenAI-compatible endpoint each.
LABEL_API_KEY=
LABEL_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_BASE_URL=
CHECK_API_KEY=
CHECK_BASE_URL=

# Solve, Judge, and Grade (opencode): the key of the model's provider, under
# the name opencode reads it from, e.g. for openai/gpt-5.5:
OPENAI_API_KEY=
